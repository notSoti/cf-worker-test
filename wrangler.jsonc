{
	"name": "cf-worker-test",
	"main": "src/index.js",
	"compatibility_date": "2026-10-29",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf-worker-test",
			"migrations_dir": "database/migrations"
		}
	],
	"env": {
		"development": {
			"name": "cf-worker-test-development",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "cf-worker-test-development",
					"migrations_dir": "database/migrations"
				}
			]
		}
	}
}
